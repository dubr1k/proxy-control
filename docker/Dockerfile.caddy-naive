FROM caddy:2.11.7-builder@sha256:d842facfd63b960922e57444ff76fd8f0793a66dfdcf481af8026e1f4e6a39b4 AS builder

# Keep the upstream immutable and apply the bounded maintained live-meter patch.
COPY docker/naive-live-meter /live-meter
RUN sh /live-meter/apply.sh d62c80d3dd2c706b6b87579844d2397bddd18317
RUN xcaddy build v2.11.7 \
    --with github.com/caddyserver/forwardproxy=/src/forwardproxy

RUN /usr/bin/caddy list-modules | grep -Fx proxy_control.naive_live_meter

FROM scratch
COPY --from=builder /usr/bin/caddy /caddy
