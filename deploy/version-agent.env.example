# Copy to /etc/proxy-control/version-agent.env and keep root:root 0600.
PROXY_CONTROL_VERSION_SOCKET=/run/proxy-control/version-agent.sock
# The panel container uses numeric GID 10001 for this socket.
PROXY_CONTROL_VERSION_SOCKET_GID=10001
PROXY_CONTROL_VERSION_CATALOG=/etc/proxy-control/versions.json
PROXY_CONTROL_VERSION_STATE=/var/lib/proxy-control/version-agent/state.json
PROXY_CONTROL_COMPOSE_DIR=/opt/mtproxy-shared443
# Keep the complete production overlay set. Do not omit active overlays.
PROXY_CONTROL_COMPOSE_FILES=compose.yaml:compose.naive.yaml:compose.mieru.yaml
PROXY_CONTROL_BINARY_PATHS=naive=/usr/local/bin/caddy,mita=/usr/bin/mita
PROXY_CONTROL_SERVICE_NAMES=naive=caddy-naive,mita=mita
PROXY_CONTROL_CHECKERS=naive=/usr/local/libexec/check-naive-caddy-build
PROXY_CONTROL_CADDYFILES=naive=/var/lib/naive-manager/Caddyfile
# The unit's ExecStartPre check reads this pin; the agent rewrites it on update.
PROXY_CONTROL_VERSION_PINS=naive=/etc/proxy-control/caddy-naive.pin
# Containers that pin a host binary by digest through their env overlay. The agent
# rewrites the key and recreates the service after the binary is replaced.
PROXY_CONTROL_CONSUMER_OVERLAYS=mita=/opt/mtproxy-shared443/.env.mieru:MIERU_MITA_SHA256:mieru-manager
PROXY_CONTROL_TELEMT_CONTAINER=proxy-control-mtproxy
PROXY_CONTROL_VERSION_HEALTH_TIMEOUT=90
# Xray-router (v0.11): on = the xray component is offered and updated from the pinned bin-dir.
# The installer writes `on` when it installs the router.
PROXY_CONTROL_XRAY_ROUTER=off
PROXY_CONTROL_XRAY_BIN_DIR=/usr/local/lib/proxy-control/xray-router
PROXY_CONTROL_XRAY_OVERLAY=/opt/mtproxy-shared443/.env.xray-router
PROXY_CONTROL_XRAY_CONTAINER=proxy-control-xray-router
# Upstream check (v0.11): off = only the local catalog is offered, the check button is hidden.
PROXY_CONTROL_UPSTREAM_CHECK=on
# NaiveProxy is updated by rebuilding Caddy on the host; the Dockerfile is staged here.
PROXY_CONTROL_CADDY_BUILD_DIR=/var/lib/proxy-control/version-agent/caddy-build
# The panel updates itself (v0.11): the release tree is synced into PROXY_CONTROL_COMPOSE_DIR,
# the agent's own code into PROXY_CONTROL_AGENT_DIR (the unit's WorkingDirectory), the panel
# image is tagged for rollback and the database of the volume is copied before the restart.
PROXY_CONTROL_AGENT_DIR=/opt/proxy-control
PROXY_CONTROL_PANEL_IMAGE=mtproxy-panel
PROXY_CONTROL_PANEL_CONTAINER=proxy-control-panel
PROXY_CONTROL_PANEL_VOLUME=mtproxy_panel-data
