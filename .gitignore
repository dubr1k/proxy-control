# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Syncthing writes partial copies beside the file it is transferring; they are
# transient artefacts of the sync, never source.
.syncthing.*
.stversions/
.stfolder

# Agent
.gemini/
.agent/

# graphify knowledge graph: derived artefacts, rebuilt from source with
# `graphify update .`. graph.json/graph.html run into megabytes and churn on
# every build, so nothing under the output dir belongs in history.
graphify-out/
# Defensive: sidecars and vaults graphify can write outside graphify-out/
# (e.g. `--obsidian-dir <path>` or a stale interpreter/root marker).
.graphify_*

# Local deployment secrets and logs. Ignore the whole directory: files added
# here later (bootstrap passwords, manager tokens) must never need a new rule.
secrets/*
!secrets/.gitkeep
.env
*.log
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
panel/*.sqlite3*
.lab-state/
lab-results/

# Runtime version-agent state is host-specific and may reference local images.
version-overrides/compose.versions.yaml

# Cover-site content is deployment-specific and must stay outside Git history
docker/site/
