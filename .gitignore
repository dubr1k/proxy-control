# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Syncthing writes partial copies beside the file it is transferring; they are
# transient artefacts of the sync, never source.
.syncthing.*
.stversions/
.stfolder

# Agent
.gemini/
.agent/
.hermes/

.worktrees/
# graphify knowledge graph (owner, 2026-10-01: «сделай граф проекта, чтобы агентам было проще
# ориентироваться, его можно запушить»): the graph, its report, its page and the file index are
# tracked so a fresh clone can `graphify query` at once; dated backups, labels and sidecars are
# not. Rebuild with `graphify update .`; release/build.py leaves the directory out of archives.
graphify-out/*
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/manifest.json
# Defensive: sidecars and vaults graphify can write outside graphify-out/
# (e.g. `--obsidian-dir <path>` or a stale interpreter/root marker).
.graphify_*

# Local deployment secrets and logs. Ignore the whole directory: files added
# here later (bootstrap passwords, manager tokens) must never need a new rule.
secrets/*
!secrets/.gitkeep
.env
# протокольные overlay установки (.env.naive, .env.mieru, .env.xray-router, .env.mcp) — конфигурация хоста, не репозитория
.env.*
!.env.*.example
*.log
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
panel/*.sqlite3*
.lab-state/
lab-results/
lab-results-container/

# Release build outputs. The documented build runs twice into sibling
# directories inside the checkout and compares the bytes, so both must be
# invisible to the clean-tree check the second build performs.
dist/
dist-again/

# Runtime version-agent state is host-specific and may reference local images.
version-overrides/compose.versions.yaml

# Cover-site content is deployment-specific and must stay outside Git history
docker/site/

# Local helper image definition: it is not part of the product and must not
# enter the release. compose.yaml consumes the upstream image by digest.
docker/Dockerfile.telemt
