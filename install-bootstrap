#!/usr/bin/env bash
# Stable-only unprivileged verification; no code from the archive runs before verification.
set -Eeuo pipefail
ARCHIVE='' CHECKSUM='' MANIFEST='' PROVENANCE='' DESTINATION=''
fail() { printf 'install-bootstrap: %s\n' "$*" >&2; exit 1; }
usage() {
    printf 'usage: install-bootstrap --archive FILE --checksum FILE --manifest FILE [--provenance FILE] [--destination DIR] [-- ARGS...]\n' >&2
    exit 2
}
while (($#)); do
    case $1 in
        --archive) ARCHIVE=${2:?}; shift 2 ;;
        --checksum) CHECKSUM=${2:?}; shift 2 ;;
        --manifest) MANIFEST=${2:?}; shift 2 ;;
        --provenance) PROVENANCE=${2:?}; shift 2 ;;
        --destination) DESTINATION=${2:?}; shift 2 ;;
        --) shift; break ;;
        *) usage ;;
    esac
done
[[ -n $ARCHIVE && -n $CHECKSUM && -n $MANIFEST ]] || usage
[[ ${EUID:-$(id -u)} -ne 0 ]] || fail 'run the verification as an unprivileged user'
check_file() {
    local path=$1 owner mode
    [[ -f $path && ! -L $path ]] || fail "not a regular file: $path"
    owner=$(stat -c '%u' -- "$path" 2>/dev/null || stat -f '%u' -- "$path")
    mode=$(stat -c '%a' -- "$path" 2>/dev/null || stat -f '%Lp' -- "$path")
    [[ $owner == "${EUID:-$(id -u)}" ]] || fail "must be owned by you: $path"
    (( (8#$mode & 0022) == 0 )) || fail "must not be group/other-writable: $path"
}
sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum -- "$1" | cut -d' ' -f1
    else shasum -a 256 -- "$1" | cut -d' ' -f1; fi
}
# Published manifests are canonical indent-2 scalar objects. Refuse ambiguity, escapes,
# duplicate keys and noncanonical JSON rather than guessing at untrusted JSON with regexes.
manifest_fields() {
    LC_ALL=C awk '
        NR == 1 { if ($0 != "{") exit 1; next }
        $0 == "}" { if (comma) exit 1; closed=1; next }
        closed { exit 1 }
        { if (count && !comma) exit 1
          if ($0 !~ /^  "[a-z_][a-z_0-9]*": ("[^"\\]*"|[0-9]+),?$/) exit 1
          comma=($0 ~ /,$/); count++
          line=$0; sub(/^  "/,"",line); key=line; sub(/".*/,"",key)
          if (seen[key]++) exit 1
          sub(/^[^"]*": /,"",line); sub(/,$/,"",line)
          if (line ~ /^"/) { sub(/^"/,"",line); sub(/"$/,"",line) }
          value[key]=line }
        END { if (!closed || !value["archive"] || !value["archive_sha256"] || !value["version"] || !value["tag"]) exit 1
              print value["archive"]; print value["archive_sha256"]; print value["version"]; print value["tag"] }
    ' "$1"
}
archive_preflight() {
    # Reject links, devices and special entries before extraction, not after following them.
    tar -tvzf "$1" | LC_ALL=C awk 'substr($0,1,1)!="-" && substr($0,1,1)!="d" { bad=1 } END { exit bad }' || return 1
    tar -tzf "$1" | LC_ALL=C awk '
        { if ($0 !~ /^proxy-control\// || $0 ~ /(^|\/)\.\.(\/|$)/ || $0 ~ /[[:cntrl:]]/) bad=1; count++ }
        END { exit bad || !count }
    '
}
verify_host_binaries() {
    local root=$1 rows path expected mode count=0
    rows=$(LC_ALL=C awk '
        /^  "binaries": \{$/ { if (seen++) exit 1; inside=1; next }
        inside && /^  },?$/ { if (comma) exit 1; inside=0; done=1; next }
        inside { if (count && !comma) exit 1
                 if ($0 !~ /^    "[a-zA-Z0-9_./-]+": "[0-9a-f]+",?$/) exit 1
                 comma=($0 ~ /,$/)
                 line=$0; sub(/^    "/,"",line); path=line; sub(/".*/,"",path)
                 sub(/^[^"]*": "/,"",line); sub(/",?$/,"",line)
                 if (length(line)!=64 || paths[path]++) exit 1
                 if (path!="installer/bin/linux-amd64/proxy-control-installer" && path!="version_agent/bin/linux-amd64/proxy-control-version-agent") exit 1
                 print path " " line; count++ }
        END { if (!done || inside || count!=2) exit 1 }
    ' "$root/release/release.json") || return 1
    while read -r path expected; do
        [[ -f $root/$path && ! -L $root/$path ]] || return 1
        mode=$(stat -c '%a' -- "$root/$path" 2>/dev/null || stat -f '%Lp' -- "$root/$path")
        [[ $mode == 755 && $(sha256_of "$root/$path") == "$expected" ]] || return 1
        count=$((count + 1))
    done <<< "$rows"
    ((count == 2))
}
check_file "$ARCHIVE"; check_file "$CHECKSUM"; check_file "$MANIFEST"
[[ -z $PROVENANCE ]] || check_file "$PROVENANCE"
archive_name=$(basename -- "$ARCHIVE")
expected=$(awk -v name="$archive_name" '$2 == name || $2 == "*"name { if (seen++) exit 1; value=$1 } END { if (!seen) exit 1; print value }' "$CHECKSUM") || fail 'checksum file must name the archive exactly once'
[[ $expected =~ ^[0-9a-f]{64}$ ]] || fail 'invalid archive checksum'
actual=$(sha256_of "$ARCHIVE")
[[ $actual == "$expected" ]] || fail 'archive checksum mismatch'
fields=$(manifest_fields "$MANIFEST") || fail 'release manifest is not canonical or is incomplete'
mapfile -t identity <<< "$fields"
[[ ${identity[0]} == "$archive_name" && ${identity[1]} == "$actual" && ${identity[3]} == "v${identity[2]}" ]] || fail 'the manifest does not describe this archive'
[[ ${identity[2]} =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail 'this bootstrap installs stable releases only'
archive_preflight "$ARCHIVE" || fail 'the release archive failed its extraction preflight'
if [[ -z $DESTINATION ]]; then DESTINATION=$(mktemp -d "${TMPDIR:-/tmp}/proxy-control-release.XXXXXX")
else
    [[ ! -e $DESTINATION ]] || fail 'the destination must not already exist'
    mkdir -m 0700 -- "$DESTINATION"
fi
chmod 0700 -- "$DESTINATION"
tar -xzf "$ARCHIVE" -C "$DESTINATION"
root=$DESTINATION/proxy-control
[[ -f $root/install.sh && ! -L $root/install.sh && -f $root/release/release.json ]] || fail 'the extracted release is incomplete'
verify_host_binaries "$root" || fail 'release host binary verification failed'
printf 'verified %s (%s)\nextracted to %s\n' "$archive_name" "$actual" "$root"
exec sudo -- bash "$root/install.sh" "$@"
