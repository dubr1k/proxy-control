{
    admin 127.0.0.1:2019
    auto_https disable_redirects
}
# NaiveProxy cover site and forward proxy for edge.example.com.
https://:443 {
    bind 127.0.0.1
    tls /var/lib/naive-caddy/tls/fullchain.pem /var/lib/naive-caddy/tls/privkey.pem
    log {
        output file /var/log/naive-proxy/access.json {
            mode 0640
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 168h
            roll_uncompressed
        }
        format json
    }
    root * /var/www/edge.example.com
    route {
        forward_proxy {
            basic_auth bootstrap-0b490e67 SbAbevs-3IcNTaabACTZYbCqCRVXvq9L
            hide_ip
            hide_via
            probe_resistance
            upstream socks5://naive-7f30b3d4:rW1nh6zq2GDi_t4RG97PD-hCPb59UZvqvh5NCPBwzkE@127.0.0.1:45101
        }
        file_server
    }
}
