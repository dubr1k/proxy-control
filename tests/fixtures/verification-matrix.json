    {"id": "secret-store", "since": "0.2", "area": "backend", "claim": "Credentials are escrowed under a master keyring: identity-bound ciphertext, overlap-first rotation, fail-closed without the key, no plaintext in errors or the database.", "proof": ["pytest::panel/tests/test_secrets_store.py::test_store_and_reveal_round_trip_binds_identity", "pytest::panel/tests/test_secrets_store.py::test_rotation_is_overlap_first_and_interrupted_rewrap_stays_decryptable", "pytest::panel/tests/test_secrets_store.py::test_missing_key_with_encrypted_rows_fails_closed_at_app_start"], "routes": [], "status": "proven"},
