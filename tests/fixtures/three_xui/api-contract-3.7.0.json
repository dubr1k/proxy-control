{
  "comment": "Pinned local 3x-ui 3.7.0 HTTP contract, recorded against a running 3.7.0 rather than from documentation. Every request this installer makes is listed here; anything outside this table is refused before a socket is opened. The panel rejects a state-changing request that carries no CSRF token, so `csrf_page` names the page the token is read from.",
  "version": "3.7.0",
  "endpoints": {
    "xray_settings": {
      "method": "POST",
      "path": "/panel/api/xray/",
      "encoding": "form"
    },
    "update_xray_settings": {
      "method": "POST",
      "path": "/panel/api/xray/update",
      "encoding": "form"
    },
    "login": {
      "method": "POST",
      "path": "/login",
      "encoding": "form"
    },
    "update_user": {
      "method": "POST",
      "path": "/panel/api/setting/updateUser",
      "encoding": "form"
    },
    "update_settings": {
      "method": "POST",
      "path": "/panel/api/setting/update",
      "encoding": "form"
    },
    "add_inbound": {
      "method": "POST",
      "path": "/panel/api/inbounds/add",
      "encoding": "json"
    },
    "list_inbounds": {
      "method": "GET",
      "path": "/panel/api/inbounds/list",
      "encoding": "empty"
    },
    "csrf_page": {
      "method": "GET",
      "path": "/",
      "encoding": "empty"
    },
    "all_settings": {
      "method": "POST",
      "path": "/panel/api/setting/all",
      "encoding": "empty"
    },
    "update_inbound": {
      "method": "POST",
      "path": "/panel/api/inbounds/update/{inbound_id}",
      "encoding": "json"
    }
  },
  "response_schema": {
    "required": [
      "success"
    ],
    "optional": [
      "msg",
      "obj"
    ]
  },
  "limits": {
    "max_response_bytes": 4194304,
    "timeout_seconds": 30
  }
}
